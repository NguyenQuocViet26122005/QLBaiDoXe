{
  "name": "monthly-parking-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tests/run-isolated.mjs",
    "test:system": "node tests/run-isolated.mjs --clients",
    "audit:data": "tsx scripts/audit-data.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "check": "npm run prisma:generate && npm run typecheck && npm run lint && npm test",
    "seed:demo": "prisma db seed && tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "3.5.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.36.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.0"
  }
}
