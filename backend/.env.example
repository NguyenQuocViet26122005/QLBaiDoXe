NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://parking_user:parking_password@127.0.0.1:3306/monthly_parking
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=parking_user
DB_PASSWORD=parking_password
DB_NAME=monthly_parking
